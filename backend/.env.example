# 本機開發直接複製成 .env 就能跑，不需要先申請任何帳號

ENV=dev

# 資料庫。預設 SQLite；正式環境換成 Supabase 的連線字串：
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@<host>:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./inkstone.db

# JWT。正式環境務必換掉，可用 python -c "import secrets;print(secrets.token_urlsafe(48))" 產生
JWT_SECRET=dev-only-insecure-secret-change-me

# 前端來源，多個用逗號分隔
CORS_ORIGINS=http://localhost:5173

# Redis（AI 對話暫存）。留空就用程序內記憶體，本機開發夠用
# REDIS_URL=rediss://default:<password>@<host>:6379

# Hugging Face。留空時 AI 走本機樣板，流程仍可完整測試
# HF_TOKEN=hf_xxx

# --- 寄信（Gmail SMTP）---
# 留空就不寄信，改把驗證連結印在後端日誌，本機開發夠用。
#
# 要真的寄信需要「應用程式密碼」，不是你的 Gmail 登入密碼：
#   1. Google 帳戶 → 安全性 → 開啟兩步驟驗證
#   2. 搜尋「應用程式密碼」→ 產生一組 16 碼
#   3. 貼在 SMTP_PASSWORD（空格可留可不留）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=cbes502034@gmail.com
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# MAIL_FROM=cbes502034@gmail.com

# 驗證信裡連結要指向的前端網址
FRONTEND_URL=http://localhost:5173
